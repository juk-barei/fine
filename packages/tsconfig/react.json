{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "React",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022", "ES2024.Promise"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "types": ["node"]
  }
}
